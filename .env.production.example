# Copy to ".env" on the server (never commit it) and fill in every value.

# --- Postgres (used by docker-compose.prod.yml to build DATABASE_URL) ---
POSTGRES_USER="catalogue"
POSTGRES_PASSWORD="change-me-strong-password"
POSTGRES_DB="catalogue"

# --- Session: openssl rand -hex 32 ---
SESSION_SECRET=""

# --- Email (Mailtrap API, see src/lib/email.ts) ---
MAILTRAP_API_TOKEN=""
MAIL_FROM="Catalogue <hello@your-domain>"
OWNER_EMAIL="owner@example.com"

# --- Domain (Caddy obtains the HTTPS certificate automatically) ---
DOMAIN="your-subdomain.duckdns.org"

# --- Initial admin account (used once by prisma/seed.prod.ts) ---
ADMIN_EMAIL="admin@your-domain"
ADMIN_PASSWORD="change-me-strong-password"
