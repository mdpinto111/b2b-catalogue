# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/catalogue?schema=public"

# --- Session: at least 32 random characters (openssl rand -hex 32) ---
SESSION_SECRET="change-me-to-a-long-random-string-0123456789"

# --- Email ---
# Option 1: Mailtrap HTTPS API (preferred, works where SMTP ports are blocked)
MAILTRAP_API_TOKEN=""
# Option 2: SMTP. Leave everything empty in development: emails are printed to the console.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Catalogue <no-reply@example.com>"
# Address of the shop owner, who receives every order
OWNER_EMAIL="owner@example.com"
